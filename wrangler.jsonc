{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "labflow-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",

  "containers": [
    {
      "class_name": "LabflowApiContainer",
      "image": "docker.io/francklinmarroq/labflow-api:v1.0.13",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "LabflowApiContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LabflowApiContainer"]
    }
  ],

  "vars": {
    "MAIL_FROM": "no-reply@fmarroquin.com",
    "FRONTEND_BASE_URL": "https://labflow-frontend.pages.dev/",
    "R2_ENDPOINT": "https://22d53d9fdf065447b515a924fdabbc2d.r2.cloudflarestorage.com",
    "R2_BUCKET": "labflow-files"
  },

  "observability": {
    "enabled": true
  }
}